# Copy to .env.docker on the server and fill in the blanks. Never commit .env.docker.

APP_NAME="LEF School Management"
APP_ENV=production
APP_KEY=                      # run: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://dev.lefsignature.com:8443
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lav_sms
DB_USERNAME=lav_sms
DB_PASSWORD=change-me-strong-password

# Used by the MariaDB container (keep in step with the DB_* values above)
MARIADB_DATABASE=lav_sms
MARIADB_USER=lav_sms
MARIADB_PASSWORD=change-me-strong-password
MARIADB_ROOT_PASSWORD=change-me-another-strong-password

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Email (Brevo SMTP). Leave MAIL_DRIVER=log to send nothing while testing.
MAIL_DRIVER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# SMS. Leave SMS_DRIVER=log to send nothing while testing.
SMS_DRIVER=log
SMS_SENDER_ID=LEF
SMSONLINEGH_API_KEY=

# Safety net for the demo data: emails/SMS only go to these addresses/numbers.
# Keep it set while the demo families are in the database.
NOTICE_ALLOWLIST=emmanuel.appiah.dev@gmail.com,+233543150780
